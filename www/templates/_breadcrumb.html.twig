{% macro breadcrumb(items, right_items) %}
<nav aria-label="Breadcrumb">
	<ol class="breadcrumb">
		{% for item in items %}
		<li class="breadcrumb-item{% if item.active %} active{% endif %}"{% if item.active %} aria-current="page"{% endif %}>
			{% if item.url and not item.active %}<a href="{{ item.url }}">{% endif %}
			{{ item.label }}
			{% if item.url and not item.active %}</a>{% endif %}
		</li>
		{% endfor %}
		{% if right_items %}
		<li class="ms-auto">
			{% for item in right_items %}
			<a href="{{ item.url }}">{{ item.label }}</a>{% if not loop.last %} {% endif %}
			{% endfor %}
		</li>
		{% endif %}
	</ol>
</nav>
{% endmacro %}
