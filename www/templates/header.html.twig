<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="description" content="{{ meta_description }}">
	
	<meta property="og:title" content="{{ title }}">
	<meta property="og:description" content="{{ meta_description }}">
	<meta property="og:url" content="{{ current_page_url }}">
	<meta property="og:type" content="{{ og_type }}">
	<meta property="og:site_name" content="{{ project }} Scripting API">
	<meta property="og:locale" content="en_US">

	<meta property="og:image" content="{{ signed_og_image_url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/png">
	
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="{{ title }}">
	<meta name="twitter:description" content="{{ meta_description }}">
	<meta name="twitter:site" content="@">
    <meta name="twitter:image" content="{{ signed_og_image_url }}">

	<link rel="canonical" href="{{ current_page_url }}">
	
	<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
	<meta name="theme-color" content="#0d6efd">
	
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;550;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
	<noscript>
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;550;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
	</noscript>

	<title>{{ title }}</title>
	
	<script type="application/ld+json">
	{{ breadcrumb_schema|raw }}
	</script>
	
	{% if page_function %}
	<script type="application/ld+json">
	{{ article_schema|raw }}
	</script>
	{% endif %}
	
	<link rel="stylesheet" href="//cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
	<link rel="stylesheet" href="{{ base_url }}style.css">

	{% if yandex_metrika_id %}
	<script type="text/javascript">
		(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
		m[i].l=1*new Date();
		for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
		k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
		(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id={{ yandex_metrika_id }}', 'ym');

		ym({{ yandex_metrika_id }}, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
	</script>
	<noscript><div><img src="https://mc.yandex.ru/watch/{{ yandex_metrika_id }}" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
	{% endif %}
</head>
<body data-baseurl="{{ base_url }}">
	<div class="mobile-header">
		<button class="menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="sidebar">☰</button>
		<div class="header-link">
			<a href="{{ base_url }}" aria-label="{{ project }} API Reference - Home">{{ project }} API</a>
		</div>
	</div>

	<div class="sidebar" id="sidebar">
		<div class="header-link">
			<a href="{{ base_url }}" aria-label="{{ project }} API Reference - Home">{{ project }} API</a>
		</div>
		
		<input class="form-control typeahead" type="text" placeholder="Search functions" aria-label="Search for functions, constants, and symbols">
		
		<noscript>
			<style>
				.typeahead {
					display: none;
				}
				
				.search-notice {
					padding: 10px;
					text-align: center;
					background-color: #e7f1ff;
					border: 1px solid #bee5eb;
					border-radius: 0.375rem;
				}
			</style>
			
			<p class="search-notice">Search requires javascript to work</p>
		</noscript>
		
		{% include '_sidebar.html.twig' %}
	</div>
	
	<div class="container-fluid">
		<div class="row">
			<main class="col-lg-12" id="pjax-container" role="main">
