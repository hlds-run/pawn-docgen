{% macro function_header(type) %}
{% set colors = {
    'forward': {'border': 'border-info', 'bg': 'bg-info', 'text': 'text-white', 'label': 'Forwards'},
    'native': {'border': 'border-success', 'bg': 'bg-success', 'text': 'text-white', 'label': 'Natives'},
    'stock': {'border': 'border-warning', 'bg': 'bg-warning', 'text': 'text-dark', 'label': 'Stocks'},
    'functag': {'border': 'border-danger', 'bg': 'bg-danger', 'text': 'text-white', 'label': 'Functags'}
} %}
{% set color = colors[type] ?? {'border': 'border-primary', 'bg': 'bg-primary', 'text': 'text-white', 'label': type} %}
<div class="card {{ color.border }} mb-2"><div class="card-header {{ color.bg }} {{ color.text }}">{{ color.label }}</div>
{% endmacro %}
