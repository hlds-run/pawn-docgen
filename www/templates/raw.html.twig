<nav aria-label="Breadcrumb">
	<ol class="breadcrumb">
		<li class="breadcrumb-item"><a href="{{ base_url }}">{{ project }}</a></li>
		<li class="breadcrumb-item"><a href="{{ base_url }}{{ current_open_file }}">{{ current_open_file }}.inc</a></li>
		<li class="breadcrumb-item active" aria-current="page">File</li>
		<li class="ms-auto"><a href="{{ base_url }}{{ current_open_file }}/__functions">Functions</a></li>
		<li><a href="{{ base_url }}{{ current_open_file }}">Constants</a></li>
	</ol>
</nav>

<article>

<h1 class="border-bottom pb-2 mb-3">File content in {{ current_open_file }}.inc</h1>

<style>
	#editor { width: 100%; height: 75vh; border: 1px solid #ddd; }
</style>

<div id="editor" role="region" aria-label="Source code"></div>

<noscript>
	<pre>{{ page_file.Content }}</pre>
</noscript>

<script>
	(function(){
		var content = {{ page_file.Content|json_encode|raw }};
		var loaderScript = document.createElement('script');
		loaderScript.src = '//cdn.jsdelivr.net/npm/monaco-editor@0.55.1/min/vs/loader.min.js';
		loaderScript.onload = function() {
			require.config({ paths: { 'vs': 'https://cdn.jsdelivr.net/npm/monaco-editor@0.55.1/min/vs' } });
			require(['vs/editor/editor.main'], function() {
				try {
					monaco.editor.create(document.getElementById('editor'), {
						value: content,
						language: 'cpp',
						readOnly: true,
						automaticLayout: true,
						minimap: { enabled: false },
						scrollBeyondLastLine: false,
						find: true,
					});
				} catch(e) {
					var pre = document.createElement('pre');
					pre.textContent = content;
					var editor = document.getElementById('editor');
					editor.parentNode.replaceChild(pre, editor);
				}
			});
		};
		loaderScript.onerror = function() {
			console.warn('Failed to load Monaco loader.');
		};
		document.head.appendChild(loaderScript);
	})();
</script>
</article>
